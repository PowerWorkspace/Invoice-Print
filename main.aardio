	mainForm.combobox.selIndex = 1;            // 按文件名
	mainForm.combobox2.selIndex = 1;           // A4
	mainForm.combobox3.selIndex = 2;           // 2
	mainForm.combobox4.selIndex = 1;           // 贯穿分割线
	mainForm.edit.text = "1";
	mainForm.spin.pos = 1;   // 与 spin 同步
	mainForm.edit2.text = "8";
	mainForm.edit3.text = "4";
	mainForm.edit4.text = "0";
	mainForm.edit5.text = "0";
	mainForm.edit6.text = "0";
	mainForm.edit7.text = "0";
	setOrient(1);
	setScale("fit");
	setLine("dash");
	mainForm.checkbox.checked = false;
	mainForm.checkbox2.checked = true;
	rebuild();
};
mainForm.button2.oncommand = function(id,event){
	resetSettings();
};

