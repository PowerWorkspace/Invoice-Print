//---------------- 导入库 ----------------
import gdip;
import sys.printer;
import fsys;
import fsys.dlg;
import io;
import process;

//---------------- 全局状态 ----------------
var fileItems = {};          // { path,name,pages,seq,mtime }
var seqCounter = 0;          // 上传顺序计数
// workDir 用相对路径经 io.fullpath 统一解析成绝对路径。createDir/mutool/io.popen 全部使用同一个绝对路径,
// 避免 io.tmpdir 为 null、fsys.getCurDir 指向非项目目录导致的相对/绝对不一致问题。
var workDir = ..io.fullpath("fapiao_merge_" + tostring(time(), "%Y%m%d%H%M%S") + "\");
fsys.createDir(workDir);
var mutoolExe = null;        // mutool 绝对路径
var composedPages = null;    // 整页 gdip.bitmap 数组
var previewBmp = null;       // 当前预览整页位图
var previewIndex = 1;        // 预览当前页码
var renderCache = {};        // 渲染缓存: [path] = { mtime, pngs },文件未变则复用,避免设置变化时重复调用mutool渲染

// 纸张定义: { 宽mm, 高mm, dmPaperSize }
var papers = {
	["A4 (210x297)"] = {210,297,9/*_DMPAPER_A4*/};
	["A5 (148x210)"] = {148,210,11/*_DMPAPER_A5*/};
	["B5 (176x250)"] = {176,250,13/*_DMPAPER_B5*/};
};

// 每页数量 -> 网格(行,列) 规则(纵向)。用户确认:1→1x1,2→2行1列,3→3行1列,4→2x2,6→3x2,8→4x2,9→3x3。横向时行列对调。
var gridMap = {
	[1]={1,1}; [2]={2,1}; [3]={3,1}; [4]={2,2};
	[6]={3,2}; [8]={4,2}; [9]={3,3};
};

//---------------- mutool 引擎管理 ----------------
var getMutool = function(){
	if(mutoolExe and fsys.exists(mutoolExe)) return mutoolExe;
	// 用 $"\res\..." 编译期嵌入获取 mutool 字节,发布独立EXE时随EXE打包;
	// 运行时写入绝对工作目录后直接运行,避免 io.popen 相对路径与工作目录不匹配。
	var dst = workDir + "mutool.exe";
	if(!fsys.exists(dst)){
		var data = $"\res\mutool.exe";  // 编译期嵌入资源,发布独立EXE时随EXE打包,避免运行时res缺失
		if(!data){
			mainForm.msgboxErr("缺少 PDF 渲染组件 mutool.exe，请确认软件资源完整。");
			return null;
		}
		..string.save(dst, data);
		if(!fsys.exists(dst)){
			mainForm.msgboxErr("无法写入 mutool.exe，请检查工作目录权限。");
			return null;
		}
	}
	mutoolExe = dst;
	return dst;
};

// 运行命令并返回全部输出(同步等待完成)
var runCmd = function(cmd){
	var p = io.popen(cmd);
	var out = "";
	if(p){
		out = p.read(-1);
		p.close();
	}
	return out;
};

// 直接启动 mutool(不经过 cmd shell,避免 %d 与嵌套引号被 shell 破坏),并等待执行完成。
// workdir 作为 mutool 的工作目录,因此输出用相对路径即可写进 workdir,不受 io.popen 工作目录影响。
var runMutool = function(params, workdir){
	if(!workdir) workdir = workDir;
	process.execute(mutoolExe, params, "open", 0, workdir, null, "close", 60000);
};

//---------------- PDF 页信息 ----------------
var getPageCount = function(pdfPath){
	var ext = ..string.lower(..string.match(pdfPath, "\.(\w+)$") or "");
	if(ext != "pdf") return 1; // 图片文件(jpg/png)视为单页
	var exe = getMutool();
	if(!exe) return 1;
	var out = runCmd('"' + exe + '" info "' + pdfPath + '"');
	var n = ..string.match(out, "Pages:\s*(\d+)");
	return tonumber(n) or 1;
};

// 渲染 PDF 所有页为 PNG(150dpi),生成 baseName-1.png ... 返回每页文件路径数组
var renderFilePages = function(pdfPath, baseName, dpi){
	var ext = ..string.lower(..string.match(pdfPath, "\.(\w+)$") or "");
	if(ext != "pdf") return { [1] = pdfPath }; // 图片文件直接作为一页
	var exe = getMutool();
	if(!exe) return {};
	// 用 process.execute 直接启动 mutool,workDir 作为其工作目录,输出相对路径即落在 workDir
	runMutool('draw -o "' + baseName + '-%d.png" -r ' + dpi + ' "' + pdfPath + '"', workDir);
	var pages = {};
	var i = 1;
	while(true){
		var f = workDir + baseName + "-" + i + ".png";
		if(!fsys.exists(f)) break;
		pages[i] = f;
		i++;
	}
	return pages;
};

// 按 dpi 渲染/取用缓存页(baseName 含 dpi 后缀,避免不同分辨率文件互相覆盖)
var getRenderPages = function(path, mtime, baseName, dpi){
	var cached = renderCache[path];
	if(cached and cached.mtime == mtime and cached[dpi]) return cached[dpi];
	var pngs = renderFilePages(path, baseName, dpi);
	if(!cached) cached = { mtime = mtime };
	cached[dpi] = pngs;
	renderCache[path] = cached;
	return pngs;
};

// 检测页面是否空白(非白像素比例 < 0.5%)
var isBlankPage = function(pngPath){
	var bmp = gdip.bitmap(pngPath);
	if(!bmp) return false;
	var small = bmp.getThumbnail(64,64);
	bmp.delete();
	if(!small) return false;
	var d = small.lockData32();
	var total = 0, nonWhite = 0;
	var rows = d.bits.rows;
	for(i=1; #rows; 1){
		var pixels = rows[i].pixels;
		for(j=1; #pixels; 1){
			total++;
			var p = pixels[j];
			var r = (p >> 16) & 0xFF;
			var g = (p >> 8) & 0xFF;
			var b = p & 0xFF;
			if(r < 250 or g < 250 or b < 250) nonWhite++;
		}
	}
	small.unlockData(d);
	small.delete();
	return (nonWhite <= total * 0.005);
};

//---------------- 读取设置 ----------------
var getSettings = function(renderDpi){
	var s = {};
	s.dpi = renderDpi or 150;
	var comboText = function(c){ var v = c.items[c.selIndex]; return v ? v : ""; };
	var paperKey = comboText(mainForm.combobox2);
	s.paper = papers[paperKey] or papers["A4 (210x297)"];
	s.perPage = tonumber(comboText(mainForm.combobox3)) or 2;
	if(s.perPage < 1) s.perPage = 1; if(s.perPage > 9) s.perPage = 9;
	s.orient = mainForm.radiobutton.checked ? "纵向" : "横向";
	if(mainForm.radiobutton3.checked) s.scaleMode = "fit";
	elseif(mainForm.radiobutton4.checked) s.scaleMode = "stretch";
	else s.scaleMode = "original";
	var cutKey = comboText(mainForm.combobox4);
	if(cutKey == "不画") s.cutMode = "none";
	elseif(cutKey == "格子虚线框") s.cutMode = "grid";
	else s.cutMode = "through"; // 贯穿分割线
	s.lineType = mainForm.radiobutton6.checked ? "dash" : "solid";
	s.drawOuter = mainForm.checkbox.checked;
	s.skipBlank = mainForm.checkbox2.checked;
	s.margin = tonumber(mainForm.edit2.text) or 8;
	s.gap = tonumber(mainForm.edit3.text) or 4;
	s.cropTop = tonumber(mainForm.edit4.text) or 0;
	s.cropBottom = tonumber(mainForm.edit5.text) or 0;
	s.cropLeft = tonumber(mainForm.edit6.text) or 0;
	s.cropRight = tonumber(mainForm.edit7.text) or 0;
	s.copies = tonumber(mainForm.edit.text) or 1;
	if(s.copies < 1) s.copies = 1;   // 份数最小为 1
	// 换算像素
	s.paperWpx = ..math.floor(s.paper[1] / 25.4 * s.dpi + 0.5);
	s.paperHpx = ..math.floor(s.paper[2] / 25.4 * s.dpi + 0.5);
	s.marginPx = s.margin / 25.4 * s.dpi;
	s.gapPx = s.gap / 25.4 * s.dpi;
	s.cropTpx = s.cropTop / 25.4 * s.dpi;
	s.cropBpx = s.cropBottom / 25.4 * s.dpi;
	s.cropLpx = s.cropLeft / 25.4 * s.dpi;
	s.cropRpx = s.cropRight / 25.4 * s.dpi;
	// 网格:横向时交换行列,并交换纸张宽高像素让纸张真正横过来
	var g = gridMap[s.perPage] or {1,1};
	if(s.orient == "横向") {
		s.rows = g[2]; s.cols = g[1];
		var pw = s.paperWpx; s.paperWpx = s.paperHpx; s.paperHpx = pw;
	}
	else { s.rows = g[1]; s.cols = g[2]; }
	return s;
};

//---------------- 排序 ----------------
var sortFiles = function(){
	var sortMode = mainForm.combobox.items[mainForm.combobox.selIndex];
	var list = {};
	for(i=1; #fileItems; 1){
		var it = fileItems[i];
		if(it) list[#list + 1] = it;   // 跳过空位,避免排序比较器收到 null
	}
	if(sortMode == "按文件名"){
		..table.sort(list, function(a,b){
			if(!a or !b) return false;
			return ..string.lower(a.name) < ..string.lower(b.name);
		});
	}
	elseif(sortMode == "按修改时间"){
		..table.sort(list, function(a,b){
			if(!a or !b) return false;
			return a.mtime < b.mtime;
		});
	}
	// 按上传顺序:保持 seq 升序
	else{
		..table.sort(list, function(a,b){
			if(!a or !b) return false;
			return a.seq < b.seq;
		});
	}
	return list;
};

//---------------- 列表刷新与统计 ----------------
var refreshList = function(){
	var sorted = sortFiles();
	mainForm.listview.clear();
	for(i=1; #sorted; 1){
		var it = sorted[i];
		mainForm.listview.addItem({i, it.name});
	}
	// 统计
	var totalPages = 0;
	for(i=1; #sorted; 1) totalPages += sorted[i].pages;
	mainForm.static7.text = #sorted;           // 份
	mainForm.static31.text = totalPages;        // 张发票页
};

//---------------- 网格绘制 ----------------
var drawInvoice = function(g, bmp, x, y, cw, ch, s){
	var srcW = bmp.width;
	var srcH = bmp.height;
	var scw = srcW - s.cropLpx - s.cropRpx;
	var sch = srcH - s.cropTpx - s.cropBpx;
	if(scw <= 0 or sch <= 0) return;
	if(s.scaleMode == "stretch"){
		g.drawImageRectRect(bmp, x, y, cw, ch, s.cropLpx, s.cropTpx, scw, sch);
	}
	elseif(s.scaleMode == "fit"){
		var sc = ..math.min(cw / scw, ch / sch);
		var dw = scw * sc; var dh = sch * sc;
		var dx = x + (cw - dw) / 2; var dy = y + (ch - dh) / 2;
		g.drawImageRectRect(bmp, dx, dy, dw, dh, s.cropLpx, s.cropTpx, scw, sch);
	}
	else{ // original 原始尺寸
		var dx = x + (cw - scw) / 2; var dy = y + (ch - sch) / 2;
		g.drawImageRectRect(bmp, dx, dy, scw, sch, s.cropLpx, s.cropTpx, scw, sch);
	}
};

var drawCutLines = function(g, rows, cols, cellW, cellH, margin, gap, pw, ph, s){
	if(s.cutMode == "none") return;
	var pen = gdip.pen(0xFF000000, 1, 2/*_GdipUnitPixel*/);
	if(s.lineType == "dash") pen.dashStyle = 2/*_GdipDashStyleDash*/;
	if(s.cutMode == "through"){
		for(i=1; rows-1; 1){
			var y = margin + i * cellH + i * gap;
			g.drawLine(pen, 0, y, pw, y);
		}
		for(j=1; cols-1; 1){
			var x = margin + j * cellW + j * gap;
			g.drawLine(pen, x, 0, x, ph);
		}
		if(s.drawOuter) g.drawRect(pen, 0, 0, pw, ph);
	}
	elseif(s.cutMode == "grid"){
		for(i=1; rows; 1){
			for(j=1; cols; 1){
				var x = margin + (j-1) * (cellW + gap);
				var y = margin + (i-1) * (cellH + gap);
				g.drawRect(pen, x, y, cellW, cellH);
			}
		}
	}
	pen.delete();
};

// 生成顺时针旋转90°的位图(宽高互换),用于发票方向按纸张方向与网格旋转
var rotateBitmap90 = function(bmp){
	var w = bmp.width, h = bmp.height;
	var rb = gdip.bitmap(h, w);
	var rg = gdip.graphics(rb);
	rg.clear(0xFFFFFFFF);
	rg.setTransform(0, 1, -1, 0, h, 0);   // x' = h - y, y' = x  → 顺时针90°
	rg.drawImage(bmp, 0, 0);
	rg.delete();
	return rb;
};

// 合成一张整页(子页列表<=每页数量)。返回 gdip.bitmap
var composeOnePage = function(subList, s){
	if(#subList == 0) return null;
	var bmp = gdip.bitmap(s.paperWpx, s.paperHpx);
	var g = gdip.graphics(bmp);
	g.clear(0xFFFFFFFF);
	var contentW = s.paperWpx - 2 * s.marginPx;
	var contentH = s.paperHpx - 2 * s.marginPx;
	var cellW = (contentW - s.gapPx * (s.cols - 1)) / s.cols;
	var cellH = (contentH - s.gapPx * (s.rows - 1)) / s.rows;
	for(i=1; #subList; 1){
		var row = ..math.floor((i - 1) / s.cols) + 1;
		var col = ((i - 1) % s.cols) + 1;
		var x = s.marginPx + (col - 1) * (cellW + s.gapPx);
		var y = s.marginPx + (row - 1) * (cellH + s.gapPx);
		var b = gdip.bitmap(subList[i]);
		if(b){
			// 发票方向:正方形网格(行=列)→发票长边沿纸张长边,纵向竖放/横向横放
			// 非正方形(2/3/6/8)→发票长边沿纸张短边,纵向横放/横向竖放
			var paperLongH = (s.paperWpx > s.paperHpx);
			var squareGrid = (s.perPage == 1 or s.perPage == 4 or s.perPage == 9);
			var targetLongH;
			if(squareGrid){
				targetLongH = paperLongH;
			}else {
				targetLongH = !paperLongH;
			}
			var invoiceLongH = (b.width > b.height);
			var needRotate = (invoiceLongH != targetLongH);
			if(needRotate){
				var rb = rotateBitmap90(b);
				// 旋转后裁剪边距随之旋转(顺时针90°): 新上=原左,新下=原右,新左=原下,新右=原上
				var ot=s.cropTpx, ob=s.cropBpx, ol=s.cropLpx, orr=s.cropRpx;
				s.cropTpx=ol; s.cropBpx=orr; s.cropLpx=ob; s.cropRpx=ot;
				drawInvoice(g, rb, x, y, cellW, cellH, s);
				s.cropTpx=ot; s.cropBpx=ob; s.cropLpx=ol; s.cropRpx=orr;
				rb.delete();
				b.delete();
			}
			else{
				drawInvoice(g, b, x, y, cellW, cellH, s);
				b.delete();
			}
		}
	}
	drawCutLines(g, s.rows, s.cols, cellW, cellH, s.marginPx, s.gapPx, s.paperWpx, s.paperHpx, s);
	g.delete();
	return bmp;
};

//---------------- 预览翻页:单页显示 + 页码指示 ----------------
var showPreviewPage = function(idx){
	if(!composedPages or #composedPages == 0){
		previewBmp = null;
		previewIndex = 1;
		mainForm.preview.redraw();
		return;
	}
	if(idx < 1) idx = 1;
	if(idx > #composedPages) idx = #composedPages;
	previewIndex = idx;
	previewBmp = composedPages[previewIndex];
	mainForm.preview.redraw();
};

//---------------- 核心:渲染+合成+预览 ----------------
// 按当前设置构建整页位图数组(不修改预览全局),用于预览与高清晰度输出
var buildComposed = function(s){
	if(#fileItems == 0) return null;
	var sorted = sortFiles();
	var allPages = {};  // 扁平化所有页 pngPath
	for(fi=1; #sorted; 1){
		var it = sorted[fi];
		var key = it.path;
		var pngs = getRenderPages(key, it.mtime, "f" + fi + "_" + s.dpi, s.dpi);
		for(pi=1; #pngs; 1){
			allPages[#allPages + 1] = pngs[pi];
		}
	}
	// 跳过空白页
	var pages = {};
	for(i=1; #allPages; 1){
		var f = allPages[i];
		if(s.skipBlank and isBlankPage(f)) continue;
		pages[#pages + 1] = f;
	}
	// 按每页数量分组合成
	var out = {};
	var group = {};
	var k = 0;
	for(i=1; #pages; 1){
		k++;
		group[k] = pages[i];
		if(k == s.perPage){
			var pageBmp = composeOnePage(group, s);
			if(pageBmp) out[#out + 1] = pageBmp;
			group = {}; k = 0;
		}
	}
	if(k > 0){
		var pageBmp = composeOnePage(group, s);
		if(pageBmp) out[#out + 1] = pageBmp;
	}
	return out;
};

//---------------- 核心:渲染+合成+预览 ----------------
var rebuild = function(){
	// 释放旧位图
	if(composedPages){
		for(i=1; #composedPages; 1) composedPages[i].delete();
		composedPages = null;
	}
	if(previewBmp){
		// previewBmp 只是 composedPages[1] 的别名,已在上面遍历中 delete 释放,这里只置空避免二次释放
		previewBmp = null;
	}
	if(#fileItems == 0){
		showPreviewPage(1);
		return;
	}
	composedPages = buildComposed(getSettings());
	// 预览第一页
	showPreviewPage(1);
};

//---------------- 预览绘制 ----------------
mainForm.preview.onDrawBackground = function(graphics, rc, backgroundColor, color){
	graphics.clear(0xFFFFFFFF);
	if(!previewBmp) return;
	// 四周留白:两侧放翻页按钮(< >),底部放页码指示(x / N),避免图片盖住它们
	var l = 26, r = 26, t = 6, b = 28;
	var ix = rc.left + l;
	var iy = rc.top + t;
	var iw = (rc.right - rc.left) - l - r;
	var ih = (rc.bottom - rc.top) - t - b;
	if(iw < 10 or ih < 10) return;
	var bw = previewBmp.width or 1;
	var bh = previewBmp.height or 1;
	var scale = math.min(iw / bw, ih / bh);
	if(scale <= 0) scale = 1;
	var w = bw * scale;
	var h = bh * scale;
	var dx = ix + (iw - w) / 2;
	var dy = iy + (ih - h) / 2;
	graphics.drawImageScale(previewBmp, { left = dx; top = dy; right = dx + w; bottom = dy + h });
	// 纸张边界:在图像四周画淡色外框
	var pen = ..gdip.pen(0xFFB0B0B0, 1);
	graphics.drawRect(pen, dx - 1, dy - 1, w + 2, h + 2);
	pen.delete();
	// 底部页码指示(随预览图一起绘制,稳定显示不闪现)
	if(#composedPages > 0){
		var str = previewIndex + " / " + #composedPages;
		var font = ..gdip.font("微软雅黑", 12);
		var brush = ..gdip.solidBrush(0xFF404040);
		var strW = #str * 7;   // 估算文本宽度以便水平居中
		var tx = (rc.left + rc.right - strW) / 2;
		var ty = rc.bottom - 26;
		graphics.drawString(str, font, tx, ty, brush);
		font.delete();
		brush.delete();
	}
};

//---------------- 文件添加/清空 ----------------
var addFiles = function(files){
	var added = 0;
	for(i=1; #files; 1){
		var path = files[i];
		var ext = ..string.lower(..string.match(path, "\.(\w+)$") or "");
		// 仅支持 pdf / jpg / jpeg / png
		if(ext != "pdf" and ext != "jpg" and ext != "jpeg" and ext != "png") continue;
		var name = ..fsys.getFileName(path);
		// 去重
		var dup = false;
		for(j=1; #fileItems; 1) if(..string.lower(fileItems[j].path) == ..string.lower(path)) { dup = true; break; }
		if(dup) continue;
		seqCounter++;
		var ft = ..fsys.getTime(path);
		fileItems[#fileItems + 1] = {
			path = path;
			name = name;
			pages = (ext == "pdf") ? 0 : 1;   // PDF 页数稍后安全计算
			seq = seqCounter;
			mtime = (ft and ft.write) or "";
		};
		added++;
	}
	if(added > 0){
		// 第一步:立即刷新列表,确保文件先进入列表(不依赖渲染引擎)
		refreshList();
		// 第二步:安全计算 PDF 页数(失败不阻断列表)
		for(i=1; #fileItems; 1){
			if(fileItems[i].pages == 0){
				try{
					fileItems[i].pages = getPageCount(fileItems[i].path);
				}catch(e){
					fileItems[i].pages = 1;
				}
			}
		}
		refreshList();
		rebuild();
	}
	else{
		mainForm.msgbox("未添加新文件（仅支持 .pdf/.jpg/.png，重复文件已忽略）");
	}
};

var clearFiles = function(){
	fileItems = {};
	seqCounter = 0;
	renderCache = {};
	refreshList();
	rebuild();
};

// 打开文件选择
var pickFiles = function(){
	var files = fsys.dlg.openMulti("支持的文件|*.pdf;*.jpg;*.jpeg;*.png|PDF文件|*.pdf|图片文件|*.jpg;*.jpeg;*.png|", "选择要合并的发票（PDF/图片）", null, mainForm);
	if(files and #files > 0) addFiles(files);
};

