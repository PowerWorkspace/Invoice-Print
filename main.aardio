mainForm.combobox.items = {"按文件名","按上传顺序","按修改时间"};
mainForm.combobox.selIndex = 1;
mainForm.combobox2.items = {"A4 (210x297)","A5 (148x210)","B5 (176x250)"};
mainForm.combobox2.selIndex = 1;
mainForm.combobox3.items = {"1","2","3","4","6","8","9"};
mainForm.combobox3.selIndex = 2;
mainForm.combobox4.items = {"贯穿分割线","格子虚线框","不画"};
mainForm.combobox4.selIndex = 1;
mainForm.checkbox2.checked = true;
setOrient(1);
setScale("fit");
setLine("dash");
// spin 微调:绑定"份数"文本框,范围 1~99,步长 1(必须先 setRange 再绑定 buddy,绑定会把当前值写入文本框)
mainForm.spin.setRange(1, 99);
mainForm.spin.buddy = mainForm.edit;
mainForm.spin.inc = 1;

// 枚举打印机
var printers = {};
var idx = 0;
var defIdx = 0;
var defPrinter = sys.printer.default();
for pname, sname, attrs in sys.printer.each(){
	idx++;
	printers[idx] = pname;
	if(pname == defPrinter) defIdx = idx;
}
mainForm.combobox5.items = printers;
mainForm.combobox5.selIndex = (defIdx > 0) ? defIdx : 1;

// listview 列
mainForm.listview.insertColumn("序号", 40);
mainForm.listview.insertColumn("文件名称", 270);

mainForm.show();
win.loopMessage();
// 退出时清理本次生成的临时工作目录(内含 mutool 副本与渲染页),避免残留堆积
if(workDir and ..fsys.exists(workDir)) ..fsys.delete(workDir);
