var setOrient = function(mode){
	mainForm.radiobutton.checked = (mode == 1);
	mainForm.radiobutton2.checked = (mode == 2);
};
var setScale = function(mode){
	mainForm.radiobutton3.checked = (mode == "fit");
	mainForm.radiobutton4.checked = (mode == "stretch");
	mainForm.radiobutton5.checked = (mode == "original");
};
var setLine = function(mode){
	mainForm.radiobutton6.checked = (mode == "dash");
	mainForm.radiobutton7.checked = (mode == "solid");
};

