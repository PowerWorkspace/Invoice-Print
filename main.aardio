// listview 右键菜单:删除所选文件
mainForm.popmenu = win.ui.popmenu(mainForm);
mainForm.popmenu.add('删除所选文件', function(id){
	var selIndex = mainForm.listview.selIndex;
	var sorted = sortFiles();
	var it = sorted[selIndex];
	if(!it) return;
	// 列表显示的是排序后的顺序,需按 seq 反查 fileItems 原下标再删除
	for(i=1; #fileItems; 1){
		if(fileItems[i].seq == it.seq){
			renderCache[fileItems[i].path] = null;   // 清理该文件的渲染缓存
			..table.remove(fileItems, i);
			break;
		}
	}
	refreshList();
	rebuild();
});
mainForm.listview.onnotify = function(id, code, ptr){
	if(code == 0xFFFFFFFB/*_NM_RCLICK*/) mainForm.popmenu.popup();
};

