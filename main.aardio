mainForm.edit3.oncommand = function(id,event){ rebuild(); };
mainForm.edit4.oncommand = function(id,event){ rebuild(); };
mainForm.edit5.oncommand = function(id,event){ rebuild(); };
mainForm.edit6.oncommand = function(id,event){ rebuild(); };
mainForm.edit7.oncommand = function(id,event){ rebuild(); };
