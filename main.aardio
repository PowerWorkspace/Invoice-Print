mainForm.btnNext.oncommand = function(id,event){ if(event == 0/*STN_CLICKED*/) showPreviewPage(previewIndex + 1); };

//---------------- 下载(合并为 PDF) ----------------
mainForm.button.oncommand = function(id,event){
	if(!composedPages or #composedPages == 0){
		mainForm.msgbox("请先添加发票文件");
		return;
	}
	var savePath = fsys.dlg.saveOp("PDF文件|*.pdf|", "保存合并后的 PDF", null, mainForm, "合并打印.pdf");
	if(!savePath) return;
	// 高清晰度输出:用 300dpi 重建整页,确保合并后下载保持发票原始清晰度
	var outPages = buildComposed(getSettings(300));
	if(!outPages or #outPages == 0){
		mainForm.msgboxErr("输出页构建失败");
		return;
	}
	// 保存整页 PNG
	var pngs = {};
	for(i=1; #outPages; 1){
		var pngPath = workDir + "outpage" + i + ".png";
		outPages[i].save(pngPath);
		pngs[i] = pngPath;
	}
	for(i=1; #outPages; 1) outPages[i].delete();
	// mutool convert 合成 PDF
	var exe = getMutool();
	if(!exe) return;
	var args = "";
	for(i=1; #pngs; 1) args += ' "' + pngs[i] + '"';
	runMutool('convert -o "' + savePath + '" -F pdf' + args, workDir);
	if(fsys.exists(savePath)){
		mainForm.msgbox('合并完成，已保存:\n' + savePath);
	}
	else{
		mainForm.msgboxErr("保存失败，请检查输出路径与 mutool 引擎。");
	}
};

//---------------- 打印 ----------------
mainForm.button3.oncommand = function(id,event){
	if(!composedPages or #composedPages == 0){
		mainForm.msgbox("请先添加发票文件");
		return;
	}
	// 高清晰度输出:打印使用 300dpi 重建整页,保持发票原始清晰度
	var outPages = buildComposed(getSettings(300));
	if(!outPages or #outPages == 0){
		mainForm.msgboxErr("输出页构建失败");
		return;
	}
	var s = getSettings(300);
	var printerName = mainForm.combobox5.text;
	var printer = sys.printer(printerName);
	if(!printer){
		for(i=1; #outPages; 1) outPages[i].delete();
		mainForm.msgboxErr("无法打开打印机" + (printerName ? "：" + printerName : ""));
		return;
	}
	var pdc = printer.createDevice(
		dmPaperSize = s.paper[3];
		dmOrientation = (s.orient == "纵向") ? 1 : 2;
		dmCopies = s.copies;
	);
	if(!pdc){
		for(i=1; #outPages; 1) outPages[i].delete();
		mainForm.msgboxErr("创建设备失败");
		return;
	}
	for(i=1; #outPages; 1){
		var bmp = outPages[i];
		pdc.start(function(hdc, rc){
			var g = gdip.graphics(hdc);
			g.pageUnit = 2/*_UnitPixel*/;
			g.drawImageStretch(bmp, rc);
			g.delete();
		}, "发票合并打印");
	}
	pdc.close();
	for(i=1; #outPages; 1) outPages[i].delete();
	mainForm.msgbox("打印完成，共 " + #outPages + " 页");
};

//---------------- 恢复默认 ----------------
